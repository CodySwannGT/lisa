{
  "attribution": {
    "commit": "\ud83e\udd16 Generated with Claude Code\n\nCo-Authored-By: Claude",
    "pr": "\ud83e\udd16 Generated with Claude Code"
  },
  "enabledPlugins": {
    "lisa@lisa": true,
    "lisa-wiki@lisa": true,
    "coderabbit@claude-plugins-official": true,
    "sentry@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "CodySwannGT/lisa": {
      "source": {
        "source": "github",
        "repo": "CodySwannGT/lisa"
      }
    }
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "1800000",
    "BASH_MAX_TIMEOUT_MS": "7200000",
    "CLAUDE_DEBUG": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "deny": []
  },
  "plansDirectory": "./plans",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/lisa-hooks/worktree-binding-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/lisa-enforcement-fallback.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/lisa-enforcement-fallback.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/lisa-hooks/worktree-binding-guard.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/lisa-plugin-registration-notice.mjs 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
