{
  "defaults": {
    "devDependencies": {
      "@graphql-codegen/cli": "^6.1.0",
      "@graphql-codegen/typescript": "^4.1.6",
      "@graphql-codegen/typescript-operations": "^4.4.2",
      "tsx": "^4.20.6"
    },
    "scripts": {
      "lint": "$npm_execpath run lint:lisa",
      "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d typeorm.config.ts src/database/migrations/$npm_config_name",
      "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d typeorm.config.ts",
      "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d typeorm.config.ts",
      "test": "$npm_execpath run test:lisa",
      "test:cov": "$npm_execpath run test:cov:lisa",
      "test:cov:unit": "$npm_execpath run test:cov:unit:lisa",
      "test:integration": "$npm_execpath run test:integration:lisa",
      "test:unit": "$npm_execpath run test:unit:lisa",
      "test:watch": "$npm_execpath run test:watch:lisa"
    },
    "dependencies": {
      "class-validator": "^0.14.3",
      "graphql": "15.10.1"
    }
  },
  "force": {
    "scripts": {
      "deploy:dev": "sls deploy --stage dev",
      "deploy:production": "sls deploy --stage production",
      "deploy:staging": "sls deploy --stage staging",
      "fetch:graphql:schema:dev": "./scripts/fetch-graphql-schema.sh development",
      "fetch:graphql:schema:production": "./scripts/fetch-graphql-schema.sh production",
      "fetch:graphql:schema:staging": "./scripts/fetch-graphql-schema.sh staging",
      "k6": "./scripts/k6-run.sh",
      "k6:docker:load": "./scripts/k6-run.sh --scenario load --docker",
      "k6:docker:smoke": "./scripts/k6-run.sh --scenario smoke --docker",
      "k6:load": "./scripts/k6-run.sh --scenario load",
      "k6:smoke": "./scripts/k6-run.sh --scenario smoke",
      "k6:soak": "./scripts/k6-run.sh --scenario soak",
      "k6:spike": "./scripts/k6-run.sh --scenario spike",
      "k6:stress": "./scripts/k6-run.sh --scenario stress",
      "lint:fix": "oxlint --fix && eslint . --fix",
      "lint:lisa": "oxlint && eslint . --quiet",
      "security:zap": "bash scripts/zap-baseline.sh",
      "setup:deploy-key": "setup-deploy-key",
      "start:dev": "IS_OFFLINE=true sls offline start --stage dev",
      "start:docker": "docker compose up",
      "start:docker:build": "docker compose up --build",
      "start:docker:down": "docker compose down",
      "start:local": "IS_OFFLINE=true sls offline start --noTimeout",
      "test:cov:lisa": "lisa-test-run --profile nestjs --adapter vitest -- vitest run --coverage",
      "test:cov:unit:lisa": "LISA_COVERAGE_SCOPE=unit lisa-test-run --profile nestjs --adapter vitest -- vitest run --coverage --exclude='**/integration/**' --exclude='**/*.integration.*'",
      "test:integration:lisa": "lisa-test-run --profile nestjs --adapter vitest -- vitest run '.integration.' 'integration/'",
      "test:lisa": "lisa-test-run --profile nestjs --adapter vitest -- vitest run",
      "test:mutation": "LISA_TEST_SCRATCH_PREFIXES='[\"lisa-mutation-\",\"worker-\"]' lisa-test-run --profile nestjs --adapter direct -- node scripts/lisa-mutation.mjs",
      "test:node": "LISA_TEST_SCRATCH_PREFIXES='[\"node-\"]' lisa-test-run --profile nestjs --adapter direct -- node scripts/lisa-test-node.mjs",
      "test:unit:lisa": "lisa-test-run --profile nestjs --adapter vitest -- vitest run --exclude='**/integration/**' --exclude='**/*.integration.*'",
      "test:watch:lisa": "lisa-test-run --profile nestjs --adapter vitest -- vitest"
    },
    "dependencies": {
      "@apollo/server": "^5.4.0",
      "@as-integrations/express5": "^1.1.2",
      "@aws-sdk/client-apigatewaymanagementapi": "^3.967.0",
      "@aws-sdk/client-cognito-identity-provider": "^3.969.0",
      "@aws-sdk/rds-signer": "^3.968.0",
      "@graphql-tools/utils": "^11.0.0",
      "@nestjs/apollo": "^13.2.3",
      "@nestjs/common": "^11.1.11",
      "@nestjs/config": "^4.0.2",
      "@nestjs/core": "^11.1.11",
      "@nestjs/graphql": "^13.2.3",
      "@nestjs/platform-express": "^11.1.11",
      "@nestjs/terminus": "^11.0.0",
      "@nestjs/typeorm": "^11.0.0",
      "@vendia/serverless-express": "^4.12.6",
      "aws-jwt-verify": "^5.1.1",
      "aws-xray-sdk-core": "^3.12.0",
      "class-transformer": "^0.5.1",
      "dataloader": "^2.2.3",
      "graphql-query-complexity": "^1.1.0",
      "graphql-subscriptions": "^3.0.0",
      "graphql-ws": "^6.0.6",
      "ioredis": "^5.9.1",
      "pg": "^8.16.3",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.2",
      "typeorm": "^0.3.28",
      "typeorm-naming-strategies": "^4.1.0"
    },
    "devDependencies": {
      "@nestjs/cli": "^11.0.14",
      "@nestjs/schematics": "^11.0.9",
      "@nestjs/testing": "^11.1.11",
      "@types/aws-lambda": "^8.10.159",
      "@types/express": "^5.0.6",
      "serverless": "^4.30.0",
      "serverless-esbuild": "^1.57.0",
      "serverless-offline": "^14.4.0",
      "vite": "^8.0.16",
      "vitest": "^4.1.0",
      "@vitest/coverage-v8": "^4.1.0",
      "eslint-plugin-oxlint": "^1.62.0",
      "oxlint": "^1.62.0",
      "oxlint-tsgolint": "^0.24.0",
      "@stryker-mutator/core": "^9.0.0",
      "@stryker-mutator/vitest-runner": "^9.0.0"
    },
    "overrides": {
      "vite": "$vite"
    },
    "resolutions": {
      "vite": "$vite"
    }
  },
  "adopt": {
    "scripts": {
      "lint": [
        "oxlint && eslint . --quiet",
        "eslint . --quiet"
      ],
      "test": [
        "lisa-test-run --profile nestjs --adapter vitest -- vitest run",
        "lisa-test-run --profile nestjs -- vitest run",
        "lisa-test-run -- vitest run"
      ],
      "test:cov": [
        "lisa-test-run --profile nestjs --adapter vitest -- vitest run --coverage",
        "lisa-test-run --profile nestjs -- vitest run --coverage",
        "lisa-test-run -- vitest run --coverage"
      ],
      "test:cov:unit": [
        "LISA_COVERAGE_SCOPE=unit lisa-test-run --profile nestjs --adapter vitest -- vitest run --coverage --exclude='**/integration/**' --exclude='**/*.integration.*'",
        "LISA_COVERAGE_SCOPE=unit lisa-test-run --profile nestjs -- vitest run --coverage --exclude='**/integration/**' --exclude='**/*.integration.*'",
        "LISA_COVERAGE_SCOPE=unit lisa-test-run -- vitest run --coverage --exclude='**/integration/**' --exclude='**/*.integration.*'"
      ],
      "test:integration": [
        "lisa-test-run --profile nestjs --adapter vitest -- vitest run '.integration.' 'integration/' --passWithNoTests",
        "lisa-test-run --profile nestjs --adapter vitest -- vitest run '.integration.' 'integration/'",
        "lisa-test-run --profile nestjs -- vitest run '.integration.' 'integration/' --passWithNoTests",
        "lisa-test-run --profile nestjs -- vitest run '.integration.' 'integration/'",
        "lisa-test-run -- vitest run '.integration.' 'integration/' --passWithNoTests",
        "lisa-test-run -- vitest run '.integration.' 'integration/'",
        "vitest run '.integration.' 'integration/' --passWithNoTests",
        "vitest run '.integration.' 'integration/'",
        "vitest run '.integration.'",
        "vitest run '.integration.' --passWithNoTests",
        "vitest run tests/integration",
        "vitest run tests/integration --passWithNoTests"
      ],
      "test:unit": [
        "lisa-test-run --profile nestjs --adapter vitest -- vitest run --exclude='**/integration/**' --exclude='**/*.integration.*'",
        "lisa-test-run --profile nestjs -- vitest run --exclude='**/integration/**' --exclude='**/*.integration.*'",
        "lisa-test-run -- vitest run --exclude='**/integration/**' --exclude='**/*.integration.*'"
      ],
      "test:watch": [
        "lisa-test-run --profile nestjs --adapter vitest -- vitest",
        "lisa-test-run --profile nestjs -- vitest",
        "lisa-test-run -- vitest"
      ]
    }
  }
}
