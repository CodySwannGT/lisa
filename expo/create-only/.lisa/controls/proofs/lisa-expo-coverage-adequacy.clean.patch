@@ -0,0 +1,8 @@
+import { lisaProofExpoCoverage } from "./lisa-proof-expo-coverage";
+
+describe("Expo coverage fixture", () => {
+  it("executes both sides of every branch", () => {
+    expect(lisaProofExpoCoverage(Array<boolean>(48).fill(false))).toBe(0);
+    expect(lisaProofExpoCoverage(Array<boolean>(48).fill(true))).toBe(48);
+  });
+});
