{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.{ts,tsx}",
    "app/**/*.{ts,tsx}",
    "src/app/**/*.{ts,tsx}"
  ],
  "project": [
    "index.tsx",
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "features/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "utils/**/*.{ts,tsx}",
    "stores/**/*.{ts,tsx}",
    "providers/**/*.{ts,tsx}",
    "constants/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}",
    "config/**/*.{ts,tsx}",
    "src/app/**/*.{ts,tsx}",
    "src/components/**/*.{ts,tsx}",
    "src/features/**/*.{ts,tsx}",
    "src/hooks/**/*.{ts,tsx}",
    "src/utils/**/*.{ts,tsx}",
    "src/stores/**/*.{ts,tsx}",
    "src/providers/**/*.{ts,tsx}",
    "src/constants/**/*.{ts,tsx}",
    "src/types/**/*.{ts,tsx}",
    "src/config/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}"
  ],
  "ignore": [
    "**/generated/**"
  ]
}
