{
  "force": {
    "scripts": {
      "setup:deploy-key": "setup-deploy-key",
      "watch": "tsc -w",
      "cdk": "cdk",
      "build": "tsc --noEmit",
      "prepare": "husky install || true",
      "test": "lisa-test-run --profile cdk -- vitest run",
      "test:unit": "lisa-test-run --profile cdk -- vitest run --exclude='**/integration/**'",
      "test:integration:lisa": "lisa-test-run --profile cdk -- vitest run '.integration.' 'integration/'",
      "test:cov": "lisa-test-run --profile cdk -- vitest run --coverage",
      "test:mutation": "lisa-test-run --profile cdk -- node scripts/lisa-mutation.mjs",
      "test:watch": "lisa-test-run --profile cdk -- vitest",
      "lint:lisa": "oxlint && eslint . --quiet",
      "lint:fix": "oxlint --fix && eslint . --fix",
      "test:node": "node scripts/lisa-test-node.mjs"
    },
    "dependencies": {
      "aws-cdk-github-oidc": "^2.4.1",
      "constructs": "^10.4.5",
      "source-map-support": "^0.5.21"
    },
    "devDependencies": {
      "aws-cdk": "^2.1127.0",
      "esbuild": "^0.28.1",
      "vite": "^8.0.16",
      "vitest": "^4.1.0",
      "@vitest/coverage-v8": "^4.1.0",
      "eslint-plugin-oxlint": "^1.62.0",
      "oxlint": "^1.62.0",
      "oxlint-tsgolint": "^0.24.0",
      "@stryker-mutator/core": "^9.0.0",
      "@stryker-mutator/vitest-runner": "^9.0.0"
    },
    "bin": {
      "infrastructure": "bin/infrastructure.js"
    },
    "private": true,
    "overrides": {
      "aws-cdk-lib": "$aws-cdk-lib",
      "esbuild": "$esbuild",
      "vite": "$vite"
    },
    "resolutions": {
      "aws-cdk-lib": "$aws-cdk-lib",
      "esbuild": "$esbuild",
      "vite": "$vite"
    }
  },
  "defaults": {
    "dependencies": {
      "@aws-cdk/aws-amplify-alpha": "^2.260.0-alpha.0",
      "aws-cdk-lib": "2.260.0"
    },
    "engines": {
      "npm": ">= 10.9.4",
      "yarn": "please-use-npm",
      "pnpm": "please-use-npm",
      "bun": "please-use-npm",
      "node": "22.21.1"
    },
    "scripts": {
      "test:integration": "$npm_execpath run test:integration:lisa",
      "lint": "$npm_execpath run lint:lisa"
    }
  },
  "adopt": {
    "scripts": {
      "test:integration": [
        "lisa-test-run --profile cdk -- vitest run '.integration.' 'integration/' --passWithNoTests",
        "lisa-test-run --profile cdk -- vitest run '.integration.' 'integration/'",
        "lisa-test-run -- vitest run '.integration.' 'integration/' --passWithNoTests",
        "lisa-test-run -- vitest run '.integration.' 'integration/'",
        "vitest run '.integration.' 'integration/' --passWithNoTests",
        "vitest run '.integration.' 'integration/'",
        "vitest run tests/integration",
        "vitest run tests/integration --passWithNoTests",
        "vitest run test/integration",
        "NODE_ENV=test jest --testPathPatterns=\"\\.integration[.\\\\-](test|spec)\\.(ts|tsx)$\" --passWithNoTests"
      ],
      "lint": [
        "oxlint && eslint . --quiet",
        "eslint . --quiet"
      ]
    }
  }
}
