{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "bin/**/*.ts",
    "lib/**/*.ts",
    "config/**/*.ts",
    "util/**/*.ts",
    "utils/**/*.ts",
    "lambda/**/*.ts",
    "lambdas/**/*.ts",
    "functions/**/*.ts"
  ],
  "project": [
    "bin/**/*.ts",
    "lib/**/*.ts",
    "config/**/*.ts",
    "util/**/*.ts",
    "utils/**/*.ts",
    "lambda/**/*.ts",
    "lambdas/**/*.ts",
    "functions/**/*.ts",
    "test/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true
}
