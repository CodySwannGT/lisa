{
  "scripts": {
    "build": "bun run build:dist && bun run build:plugins",
    "build:dist": "node scripts/clean-dist.mjs && tsc && node scripts/copy-codex-scripts.mjs && node scripts/copy-opencode-plugin-templates.mjs",
    "build:dist:in-place": "tsc && node scripts/copy-codex-scripts.mjs && node scripts/copy-opencode-plugin-templates.mjs",
    "lisa-test-run": "bun run build && node dist/cli/lisa-test-run.js --profile lisa",
    "test:integration": "$npm_execpath run lisa-test-run -- --adapter vitest -- vitest run tests/integration",
    "test:integration:push": "$npm_execpath run lisa-test-run -- --adapter vitest -- vitest run tests/integration --exclude='**/mutation-gate-bite.test.ts' --exclude='**/mutation-gate-diff-bite.test.ts' --exclude='**/mutation-sigterm-control.test.ts' --exclude='**/mutation-performance-fixture.test.ts' --exclude='**/mutation-performance-packed-apply.test.ts'",
    "postinstall": "bash ./scripts/install-claude-plugins.sh || true; node ./scripts/install-generated-artifact-merge-driver.mjs || true; tsc || true",
    "pretest": "bun run build",
    "test": "$npm_execpath run lisa-test-run -- --adapter vitest -- vitest run",
    "test:unit": "$npm_execpath run lisa-test-run -- --adapter vitest -- vitest run --exclude='**/integration/**' --exclude='**/*.integration.*'",
    "test:cov": "$npm_execpath run lisa-test-run -- --adapter vitest -- vitest run --coverage",
    "test:cov:unit": "LISA_COVERAGE_SCOPE=unit $npm_execpath run lisa-test-run -- --adapter vitest -- vitest run --coverage --exclude='**/integration/**' --exclude='**/*.integration.*'",
    "test:cov:unit:push": "LISA_COVERAGE_SCOPE=unit $npm_execpath run lisa-test-run -- --adapter vitest -- vitest run --coverage --exclude='**/integration/**' --exclude='**/*.integration.*' --exclude='**/measure-tmpdir-growth-performance.test.ts'",
    "pretest:mutation": "bun run build",
    "test:mutation": "LISA_TEST_SCRATCH_PREFIXES='[\"lisa-mutation-\",\"worker-\"]' $npm_execpath run lisa-test-run -- --adapter direct -- node scripts/lisa-mutation.mjs",
    "test:mutation:full": "LISA_TEST_SCRATCH_PREFIXES='[\"lisa-mutation-\",\"worker-\"]' $npm_execpath run lisa-test-run -- --adapter direct -- node scripts/lisa-mutation.mjs --all",
    "lint": "oxlint --disable-nested-config && eslint . --quiet",
    "lint:fix": "oxlint --fix --disable-nested-config && eslint . --fix",
    "lint:slow": "eslint . --config eslint.slow.config.ts --quiet",
    "typecheck": "tsc --noEmit && bun run typecheck:tests",
    "typecheck:tests": "node scripts/check-typecheck-tests.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --check . --write",
    "knip:check": "knip",
    "knip:fix": "knip --fix",
    "sg:scan": "ast-grep scan",
    "sg:test": "ast-grep test",
    "build:plugins": "bash scripts/build-plugins.sh",
    "prepare": "node -e \"if (process.env.INIT_CWD?.includes('.serverless')) process.exit(0); process.exit(1);\" || husky install || true",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test:watch": "$npm_execpath run lisa-test-run -- --adapter vitest -- vitest",
    "update-node-version": "tsx scripts/update-node-version.ts",
    "cleanup:amplify-branches": "bash scripts/cleanup-amplify-branches.sh",
    "cleanup:github-branches": "bash scripts/cleanup-github-branches.sh",
    "github:status": "bash scripts/github-status-check.sh",
    "setup:deploy-key": "bash scripts/setup-deploy-key.sh",
    "lisa:enforcement-census": "bun run build:dist:in-place && node scripts/lisa-enforcement-census.mjs",
    "lisa:update:local": "bash scripts/lisa-update-local.sh",
    "lisa:commit-and-pr:local": "bash scripts/lisa-commit-and-pr-local.sh",
    "prepublishOnly": "$npm_execpath run build",
    "check:plugins": "bash scripts/check-plugins-sync.sh",
    "check:learnings-budget": "bun scripts/check-learnings-budget.ts",
    "check:ui-demo-data": "node scripts/check-ui-demo-data.mjs",
    "check:behavior-contract": "BDD_COVERAGE_ROOT=. node expo/copy-overwrite/scripts/check-bdd-coverage.mjs",
    "bdd:coverage": "bun run check:behavior-contract",
    "bdd:coverage:write": "BDD_COVERAGE_ROOT=. node expo/copy-overwrite/scripts/check-bdd-coverage.mjs --write",
    "bdd:matrix": "BDD_COVERAGE_ROOT=. node expo/copy-overwrite/scripts/bdd-matrix.mjs --write",
    "build:upstream-evidence-manifest": "node scripts/generate-upstream-evidence-manifest.mjs",
    "check:upstream-evidence-manifest": "node scripts/generate-upstream-evidence-manifest.mjs --check",
    "build:lisa-owned-hash-ledger": "node scripts/generate-lisa-owned-hash-ledger.mjs",
    "check:lisa-owned-hash-ledger": "node scripts/generate-lisa-owned-hash-ledger.mjs --check",
    "build:nightly-guard-certificate": "node scripts/generate-nightly-e2e-guard-certificate.mjs",
    "check:nightly-guard-certificate": "node scripts/generate-nightly-e2e-guard-certificate.mjs --check",
    "generate:two-channel-couplings": "bun scripts/generate-two-channel-couplings.ts",
    "check:two-channel-couplings": "bun scripts/generate-two-channel-couplings.ts --check",
    "check:deletion-basis": "node scripts/check-deletion-basis.mjs",
    "check:artifacts": "failed=''; bun run check:upstream-evidence-manifest || failed=\"$failed upstream-evidence-manifest\"; bun run check:lisa-owned-hash-ledger || failed=\"$failed lisa-owned-hash-ledger\"; bun run check:nightly-guard-certificate || failed=\"$failed nightly-guard-certificate\"; bun run check:two-channel-couplings || failed=\"$failed two-channel-couplings\"; bun run check:deletion-basis || failed=\"$failed deletion-basis\"; bun run check:merge-coverage || failed=\"$failed merge-coverage\"; if [ -n \"$failed\" ]; then echo \"check:artifacts FAILED, and these are the checks that failed:$failed\"; exit 1; fi; echo \"check:artifacts OK - all 6 generated-artifact checks passed.\"",
    "refresh:upstream-public-commits": "node scripts/generate-upstream-evidence-manifest.mjs --refresh-public-commits",
    "check:rules-pairing": "bash scripts/check-rules-pairing.sh",
    "check:pipeline-status-reads": "node scripts/check-pipeline-status-reads.mjs",
    "check:whole-output-guards": "node scripts/check-whole-output-guards.mjs",
    "check:empty-subject-guards": "node scripts/check-empty-subject-guards.mjs",
    "check:probe-absence-direction": "node scripts/check-probe-absence-direction.mjs",
    "check:shell-guard-refusals": "bun run build && $npm_execpath run lisa-test-run -- --adapter direct -- node scripts/check-shell-guard-refusal-coverage.mjs --trace-out .lisa/shell-guard-trace.jsonl",
    "check:workflow-inputs": "node scripts/detect-stale-workflow-inputs.mjs --project . --project typescript/create-only --project rails/create-only --json",
    "check:conflict-markers": "node all/copy-overwrite/scripts/check-conflict-markers.mjs",
    "check:vacuous-required-checks": "node typescript/copy-overwrite/scripts/check-skipped-required-checks.mjs --vacuity",
    "check:orphan-processes": "node scripts/check-orphan-test-processes.mjs",
    "check:merge-drivers": "node scripts/check-merge-driver-registration.mjs",
    "check:failure-signatures": "node plugins/src/base/hooks/failure-signature-index.mjs --check",
    "check:withdrawn-rulings": "node plugins/src/base/hooks/withdrawn-rulings.mjs --check",
    "check:template-workflow-refs": "node scripts/check-template-workflow-refs.mjs",
    "check:third-party-action-pins": "node scripts/check-third-party-action-pins.mjs",
    "check:workflow-package-paths": "node scripts/check-workflow-package-paths.mjs",
    "check:delivery-deletion-conflicts": "node scripts/check-delivery-deletion-conflicts.mjs",
    "check:duplicate-versions": "node scripts/check-duplicate-versions.mjs",
    "check:required-check-promotions": "node scripts/check-required-check-promotions.mjs",
    "check:self-pin": "node scripts/check-self-dependency-pin.mjs",
    "policy:reconcile": "node all/copy-overwrite/scripts/lisa-reconcile-policy.mjs",
    "check:work-item": "node scripts/lisa-work-item.mjs validate-pr",
    "check:work-item:push": "node scripts/lisa-work-item.mjs validate-push",
    "check:thresholds": "node plugins/src/base/hooks/threshold-ratchet.mjs --base HEAD^",
    "verify:health-contract": "bun run build:dist && node scripts/verify-health-contract-built.mjs",
    "verify:health-deterministic": "bun run build:dist && node scripts/verify-health-deterministic-built.mjs",
    "verify:learner-frontmatter-built": "bun run build:dist && node scripts/verify-learner-frontmatter-built.mjs",
    "verify:packed-learnings-contract": "bun run build:dist && node scripts/verify-packed-learnings-contract.mjs",
    "verify:health-agentic": "bun run build:dist && node scripts/verify-health-agentic-built.mjs",
    "verify:health-consumer": "bun run build:dist && node scripts/verify-health-consumer-built.mjs",
    "measure:tmpdir-growth": "node scripts/measure-tmpdir-growth.mjs",
    "lint:staged": "lint-staged --config .lintstagedrc.json",
    "check:merge-coverage": "node scripts/check-generated-artifact-merge-coverage.mjs"
  },
