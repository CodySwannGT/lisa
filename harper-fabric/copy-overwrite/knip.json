{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/build/**/*.ts",
    "src/harper/**/*.ts",
    "src/scripts/**/*.ts",
    "src/web/**/*.ts",
    "tests/**/*smoke.ts"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignore": [
    "harper-app/resources.js",
    "harper-app/resource-*.js",
    "harper-app/*.js",
    "harper-app/web/**",
    "harper-app/lib/**",
    "src/types/harper-schema.ts"
  ]
}
