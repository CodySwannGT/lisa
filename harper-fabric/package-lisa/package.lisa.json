{
  "force": {
    "scripts": {
      "bootstrap": "bash scripts/bootstrap.sh",
      "format": "prettier --check . --write",
      "format:check:lisa": "prettier --check .",
      "knip:check:lisa": "knip",
      "knip:fix": "knip --fix",
      "lint:fix": "oxlint --fix && eslint . --fix",
      "lint:lisa": "oxlint && eslint . --quiet",
      "lint:slow:lisa": "eslint . --config eslint.slow.config.ts --quiet",
      "prepare": "husky install || true",
      "reset": "harperdb stop || true; [ -n \"$HOME\" ] && rm -rf \"$HOME/.harperdb\" && bun run bootstrap && bun run seed && bun run verify",
      "setup:deploy-key": "setup-deploy-key",
      "sg:scan:lisa": "ast-grep scan",
      "sg:test": "ast-grep test",
      "start": "harperdb start",
      "status": "harperdb status",
      "stop": "harperdb stop",
      "test:cov:lisa": "lisa-test-run --profile harper-fabric --adapter vitest -- vitest run --coverage",
      "test:cov:unit:lisa": "LISA_COVERAGE_SCOPE=unit lisa-test-run --profile harper-fabric --adapter vitest -- vitest run --coverage --exclude='**/integration/**'",
      "test:integration:lisa": "lisa-test-run --profile harper-fabric --adapter vitest -- vitest run '.integration.' 'integration/'",
      "test:lisa": "lisa-test-run --profile harper-fabric --adapter vitest -- vitest run",
      "test:mutation": "LISA_TEST_SCRATCH_PREFIXES='[\"lisa-mutation-\",\"worker-\"]' lisa-test-run --profile harper-fabric --adapter direct -- node scripts/lisa-mutation.mjs",
      "test:node": "LISA_TEST_SCRATCH_PREFIXES='[\"node-\"]' lisa-test-run --profile harper-fabric --adapter direct -- node scripts/lisa-test-node.mjs",
      "test:unit:lisa": "lisa-test-run --profile harper-fabric --adapter vitest -- vitest run --exclude='**/integration/**'",
      "test:watch:lisa": "lisa-test-run --profile harper-fabric --adapter vitest -- vitest",
      "typecheck:lisa": "tsc --noEmit"
    },
    "dependencies": {
      "harperdb": "^4.7.29"
    },
    "devDependencies": {
      "@ast-grep/cli": "^0.40.4",
      "@commitlint/cli": "^20.3.1",
      "@commitlint/config-conventional": "^20.3.1",
      "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
      "@eslint/eslintrc": "^3.2.0",
      "@eslint/js": "^9.39.0",
      "@types/node": "^22.0.0",
      "@vitest/coverage-v8": "^4.1.0",
      "eslint": "^9.39.0",
      "eslint-config-prettier": "^10.0.0",
      "eslint-import-resolver-typescript": "^4.4.4",
      "eslint-plugin-functional": "^9.0.0",
      "eslint-plugin-import": "^2.32.0",
      "eslint-plugin-jsdoc": "^61.5.0",
      "eslint-plugin-oxlint": "^1.62.0",
      "eslint-plugin-prettier": "^5.5.0",
      "eslint-plugin-sonarjs": "^4.0.0",
      "husky": "^8.0.0",
      "jiti": "^2.4.0",
      "lint-staged": "^16.2.7",
      "oxlint": "^1.62.0",
      "oxlint-tsgolint": "^0.22.1",
      "playwright": "^1.56.1",
      "prettier": "^3.3.3",
      "tsx": "^4.20.6",
      "typescript": "^6.0.3",
      "uuid": "^13.0.0",
      "vitest": "^4.1.0"
    },
    "engines": {
      "npm": "please-use-bun",
      "yarn": "please-use-bun",
      "pnpm": "please-use-bun",
      "bun": ">= 1.3.11",
      "node": ">= 22.21.1"
    },
    "packageManager": "bun@1.3.11",
    "private": true
  },
  "merge": {
    "trustedDependencies": [
      "@ast-grep/cli",
      "@codyswann/lisa",
      "@sentry/cli"
    ]
  },
  "defaults": {
    "scripts": {
      "build": "tsc && node dist/build/build.js",
      "deploy": "bun run build && node dist/scripts/deploy.js",
      "dev:server": "bun run build && node dist/scripts/dev_server.js",
      "format:check": "$npm_execpath run format:check:lisa",
      "knip:check": "$npm_execpath run knip:check:lisa",
      "lint": "$npm_execpath run lint:lisa",
      "lint:slow": "$npm_execpath run lint:slow:lisa",
      "seed": "bun run build && node dist/scripts/seed.js",
      "sg:scan": "$npm_execpath run sg:scan:lisa",
      "test": "$npm_execpath run test:lisa",
      "test:cov": "$npm_execpath run test:cov:lisa",
      "test:cov:unit": "$npm_execpath run test:cov:unit:lisa",
      "test:unit": "$npm_execpath run test:unit:lisa",
      "test:watch": "$npm_execpath run test:watch:lisa",
      "typecheck": "$npm_execpath run typecheck:lisa",
      "verify": "bun run build && node dist/scripts/verify.js"
    }
  },
  "remove": {
    "scripts": [
      "knip",
      "knip:lisa"
    ]
  },
  "adopt": {
    "scripts": {
      "format:check": [
        "prettier --check ."
      ],
      "knip:check": [
        "knip"
      ],
      "lint": [
        "oxlint && eslint . --quiet",
        "eslint . --quiet"
      ],
      "lint:slow": [
        "eslint . --config eslint.slow.config.ts --quiet"
      ],
      "sg:scan": [
        "ast-grep scan"
      ],
      "test": [
        "lisa-test-run --profile harper-fabric --adapter vitest -- vitest run",
        "lisa-test-run --profile harper-fabric -- vitest run",
        "lisa-test-run -- vitest run"
      ],
      "test:cov": [
        "lisa-test-run --profile harper-fabric --adapter vitest -- vitest run --coverage",
        "lisa-test-run --profile harper-fabric -- vitest run --coverage",
        "lisa-test-run -- vitest run --coverage"
      ],
      "test:cov:unit": [
        "LISA_COVERAGE_SCOPE=unit lisa-test-run --profile harper-fabric --adapter vitest -- vitest run --coverage --exclude='**/integration/**'",
        "LISA_COVERAGE_SCOPE=unit lisa-test-run --profile harper-fabric -- vitest run --coverage --exclude='**/integration/**'",
        "LISA_COVERAGE_SCOPE=unit lisa-test-run -- vitest run --coverage --exclude='**/integration/**'"
      ],
      "test:unit": [
        "lisa-test-run --profile harper-fabric --adapter vitest -- vitest run --exclude='**/integration/**'",
        "lisa-test-run --profile harper-fabric -- vitest run --exclude='**/integration/**'",
        "lisa-test-run -- vitest run --exclude='**/integration/**'"
      ],
      "test:watch": [
        "lisa-test-run --profile harper-fabric --adapter vitest -- vitest",
        "lisa-test-run --profile harper-fabric -- vitest",
        "lisa-test-run -- vitest"
      ],
      "typecheck": [
        "tsc --noEmit"
      ]
    }
  }
}
