{
  "harness": "fleet",
  "tracker": "github",
  "source": "github",
  "workItem": {
    "verify": "full"
  },
  "github": {
    "org": "CodySwannGT",
    "repo": "lisa",
    "rulesets": {
      "requiredChecks": {
        "quality checks": [
          {
            "context": "🧩 Plugin artifacts match source",
            "integration_id": 15368
          }
        ]
      }
    },
    "labels": {
      "build": {
        "ready": "status:ready",
        "claimed": "status:in-progress",
        "blocked": "status:blocked",
        "human_needed": "human-needed",
        "done": {
          "dev": "status:on-dev",
          "staging": "status:on-stg",
          "production": "status:done"
        }
      },
      "prd": {
        "draft": "prd-draft",
        "ready": "prd-ready",
        "in_review": "prd-in-review",
        "blocked": "prd-blocked",
        "ticketed": "prd-ticketed",
        "shipped": "prd-shipped",
        "verified": "prd-verified",
        "sentinel": "prd-intake-feedback"
      }
    }
  },
  "deploy": {
    "branches": {
      "production": "main"
    }
  },
  "quality": {
    "testCoverage": {
      "global": {
        "statements": 74,
        "branches": 65,
        "functions": 60,
        "lines": 75
      }
    },
    "lintBudgets": {
      "cognitiveComplexity": 10,
      "maxLines": 300,
      "maxLinesPerFunction": 75
    },
    "mutation": {
      "gate": {
        "enabled": true,
        "since": "main"
      },
      "strykerThresholds": {
        "high": 80,
        "low": 60,
        "break": 60
      }
    },
    "e2eCoverage": {
      "playwright": {
        "routes": 80
      },
      "maestro": {
        "routes": 80
      }
    }
  },
  "gates": {
    "runner": "bun run",
    "code-style": {
      "commit": {
        "level": "required",
        "run": "lint:staged"
      },
      "pull-request": "required"
    },
    "code-style-slow": {
      "push": "required",
      "pull-request": "required"
    },
    "format-conformance": {
      "pull-request": "required"
    },
    "type-correctness": {
      "push": "required",
      "pull-request": "required"
    },
    "build-integrity": {
      "pull-request": "required"
    },
    "test-correctness": {
      "push": "required",
      "pull-request": "required",
      "run": "test:cov:unit"
    },
    "test-integration": {
      "push": {
        "level": "required",
        "run": "test:integration:push"
      },
      "pull-request": "required"
    },
    "coverage-adequacy": {
      "run": "test:cov:unit",
      "push": "required"
    },
    "structural-rules": {
      "run": "sg:scan",
      "commit": "required",
      "pull-request": "optional"
    },
    "traceability": {
      "push": "required",
      "pull-request": "required"
    },
    "threshold-monotonicity": {
      "push": "optional"
    },
    "dead-code": {
      "run": "knip:check",
      "push": "required",
      "pull-request": "required"
    },
    "artifact-freshness": {
      "commit": "required",
      "pull-request": "optional"
    },
    "learnings-budget": {
      "pull-request": "required"
    },
    "conflict-residue": {
      "push": "required",
      "pull-request": "optional"
    },
    "test-meaningfulness": {
      "pull-request": "optional"
    },
    "behavior-contract": {
      "run": "check:behavior-contract",
      "pull-request": "required"
    },
    "test-node-suites": {
      "push": "off",
      "pull-request": "off"
    },
    "code-review": {
      "pull-request": {
        "level": "required",
        "await": "CodeRabbit",
        "posted_by": 347564,
        "evidence": {
          "reviewer": true,
          "proof": ["Review completed"]
        }
      }
    },
    "credential-leakage": {
      "pull-request": {
        "level": "required",
        "await": "GitGuardian Security Checks",
        "posted_by": 46505
      }
    },
    "x-orphan-fixture-processes": {
      "push": {
        "level": "optional",
        "run": "check:orphan-processes"
      }
    },
    "x-failure-signature-index": {
      "push": {
        "level": "required",
        "run": "check:failure-signatures"
      }
    }
  },
  "policy": {
    "on_drift": "repair",
    "merge": {
      "squash": false,
      "merge_commit": true,
      "rebase": false,
      "auto_merge": true,
      "delete_branch_on_merge": true,
      "allow_update_branch": true
    },
    "history": {
      "linear": false,
      "signed_commits": false,
      "commit_signoff": false
    },
    "protect": {
      "force_push": true,
      "deletion": true,
      "up_to_date_before_merge": false,
      "conversation_resolution": true,
      "dismiss_stale_reviews": false,
      "require_last_push_approval": false
    },
    "repository": {
      "has_issues": true,
      "has_wiki": false,
      "default_branch": "main"
    },
    "review": {
      "required_approving_review_count": 0,
      "require_code_owner_review": false
    },
    "ruleset": {
      "enforcement": "active",
      "include_refs": [
        "~DEFAULT_BRANCH",
        "refs/heads/dev",
        "refs/heads/staging",
        "refs/heads/main"
      ],
      "exclude_refs": [],
      "bypass_actors": [
        {
          "actor_id": null,
          "actor_type": "DeployKey",
          "bypass_mode": "always"
        },
        {
          "actor_id": 5,
          "actor_type": "RepositoryRole",
          "bypass_mode": "always"
        }
      ]
    }
  },
  "_lisaSync": {
    "populated": {
      "quality.mutation.gate": {
        "enabled": false,
        "since": "main"
      },
      "quality.mutation.strykerThresholds": {
        "high": 80,
        "low": 60,
        "break": 60
      },
      "intake.repair": {
        "staleAfterHours": 2,
        "maxCandidates": 100
      },
      "monitor": {
        "maxCandidates": 20,
        "gapTiers": "core",
        "backoffHours": 24,
        "thresholds": {
          "minEvents24h": 1,
          "errorRateSpikeMultiplier": 2,
          "p95LatencyMs": 1000,
          "faultRatePct": 5
        }
      },
      "github.labels": {
        "build": {
          "ready": "status:ready",
          "claimed": "status:in-progress",
          "blocked": "status:blocked",
          "human_needed": "human-needed",
          "done": {
            "dev": "status:on-dev",
            "staging": "status:on-stg",
            "production": "status:done"
          }
        },
        "prd": {
          "draft": "prd-draft",
          "ready": "prd-ready",
          "in_review": "prd-in-review",
          "blocked": "prd-blocked",
          "ticketed": "prd-ticketed",
          "shipped": "prd-shipped",
          "verified": "prd-verified",
          "sentinel": "prd-intake-feedback"
        }
      },
      "quality.e2eCoverage": {
        "playwright": {
          "routes": 80
        },
        "maestro": {
          "routes": 80
        }
      }
    }
  },
  "intake": {
    "repair": {
      "staleAfterHours": 2,
      "maxCandidates": 100
    }
  },
  "monitor": {
    "maxCandidates": 20,
    "gapTiers": "core",
    "backoffHours": 24,
    "thresholds": {
      "minEvents24h": 1,
      "errorRateSpikeMultiplier": 2,
      "p95LatencyMs": 1000,
      "faultRatePct": 5
    }
  },
  "secrets": {
    "provider": "bitwarden",
    "bootstrap": {
      "sources": [
        "env",
        "keychain"
      ],
      "key": "BWS_ACCESS_TOKEN_lisa"
    }
  },
  "remoteEnv": {
    "tools": {
      "require": [
        {
          "name": "node",
          "minVersion": "20"
        },
        {
          "name": "curl"
        },
        {
          "name": "unzip"
        },
        {
          "name": "tar"
        }
      ],
      "install": [
        {
          "name": "bws",
          "version": "2.1.0",
          "platforms": {
            "linux-x64": {
              "install": "release-zip",
              "url": "https://github.com/bitwarden/sdk-sm/releases/download/bws-v2.1.0/bws-x86_64-unknown-linux-gnu-2.1.0.zip",
              "sha256": "ba8233c3a4aee5d43e3c73bbd04d99e9bc5aba13bbbfd06d89b073abe732b860"
            },
            "darwin-arm64": {
              "install": "release-zip",
              "url": "https://github.com/bitwarden/sdk-sm/releases/download/bws-v2.1.0/bws-aarch64-apple-darwin-2.1.0.zip",
              "sha256": "9cb1c1c6e6164d83b2e339883ba02b4cbb37188ce9a484b1ce8249443163e066"
            },
            "darwin-x64": {
              "install": "release-zip",
              "url": "https://github.com/bitwarden/sdk-sm/releases/download/bws-v2.1.0/bws-x86_64-apple-darwin-2.1.0.zip",
              "sha256": "6f626b3971368902af1b9847c02791a1b4666969d7561e2047681cded7997537"
            }
          }
        },
        {
          "name": "gh",
          "version": "2.83.0",
          "platforms": {
            "linux-x64": {
              "install": "release-tar",
              "url": "https://github.com/cli/cli/releases/download/v2.83.0/gh_2.83.0_linux_amd64.tar.gz",
              "sha256": "a5cf6cdb40fc67751adf561126b3314044779cea81ba4f254fbe8e9a69f1676f",
              "binary": "gh_2.83.0_linux_amd64/bin/gh"
            },
            "darwin-arm64": {
              "install": "release-zip",
              "url": "https://github.com/cli/cli/releases/download/v2.83.0/gh_2.83.0_macOS_arm64.zip",
              "sha256": "fecba907bc361d5e33620dbf1145f11432c39fb2b388a839463cfbb89a84820b",
              "binary": "gh_2.83.0_macOS_arm64/bin/gh"
            },
            "darwin-x64": {
              "install": "release-zip",
              "url": "https://github.com/cli/cli/releases/download/v2.83.0/gh_2.83.0_macOS_amd64.zip",
              "sha256": "0c0de650752bb92d7283e386cafd03d9ac5f47028c648c4ab821ef08a75c0716",
              "binary": "gh_2.83.0_macOS_amd64/bin/gh"
            }
          }
        },
        {
          "name": "playwright",
          "install": "npm-global",
          "package": "@playwright/test",
          "version": "1.62.1"
        }
      ]
    },
    "surfaces": {
      "claude-web": {
        "routineId": "trig_01Szp6mAMiK9V8dKWSJLJkRo",
        "fireUrl": "https://api.anthropic.com/v1/claude_code/routines/trig_01Szp6mAMiK9V8dKWSJLJkRo/fire",
        "tokenKey": "CLAUDE_ROUTINE_TOKEN"
      }
    }
  },
  "automations": {
    "build-intake": {
      "scheduler": "github-actions",
      "schedule": "0 7 * * *",
      "executionEnv": "claude-web",
      "skill": "lisa-github-build-intake",
      "enabled": false
    }
  }
}
