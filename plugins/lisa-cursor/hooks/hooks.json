{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/enforce-verification-gate.sh"
      }
    ],
    "postToolUse": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/shell-write-nudge.sh",
        "matcher": "Bash"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/failure-signature-index.sh",
        "matcher": "Bash"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/threshold-ratchet.sh",
        "matcher": "Edit|Write|NotebookEdit|Bash"
      }
    ],
    "preToolUse": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/block-no-verify.sh",
        "matcher": "Bash"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/parity-safety-net.sh",
        "matcher": "Bash"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/block-shell-json-parsing.sh",
        "matcher": "Bash"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/block-instruction-file-edits.sh",
        "matcher": "Bash"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/block-direct-issue-create.sh",
        "matcher": "Bash"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/block-blind-automerge.sh",
        "matcher": "Bash"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/block-instruction-file-edits.sh",
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/enforce-verification-gate.sh"
      }
    ],
    "stop": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/enforce-verification-gate.sh"
      }
    ],
    "sessionStart": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/install-pkgs.sh",
        "matcher": "startup"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/inject-resolved-config.sh"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/setup-jira-cli.sh"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/secrets-preflight.sh"
      }
    ],
    "subagentStart": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/inject-resolved-config.sh"
      },
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/enforce-verification-gate.sh"
      }
    ],
    "sessionEnd": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/cleanup-stale-worktrees.sh"
      }
    ]
  }
}
