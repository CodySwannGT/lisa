{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.ts",
    "lambdas/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "lambdas/**/*.ts",
    "lib/**/*.ts",
    "tests/**/*.ts",
    "test/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true
}
