{
  "force": {
    "scripts": {
      "setup:deploy-key": "setup-deploy-key",
      "lint:lisa": "oxlint && eslint . --quiet",
      "format:check:lisa": "prettier --check .",
      "format": "prettier --check . --write",
      "test": "vitest run",
      "test:unit": "vitest run --exclude='**/integration/**'",
      "test:integration:lisa": "vitest run '.integration.' 'integration/'",
      "test:cov": "vitest run --coverage",
      "test:cov:unit": "vitest run --coverage --exclude='**/integration/**'",
      "test:mutation": "node scripts/lisa-mutation.mjs",
      "test:watch": "vitest",
      "lint:fix": "oxlint --fix && eslint . --fix",
      "lint:slow:lisa": "eslint . --config eslint.slow.config.ts --quiet",
      "typecheck:lisa": "tsc --noEmit",
      "knip:check:lisa": "knip",
      "knip:fix": "knip --fix",
      "sg:scan:lisa": "ast-grep scan",
      "sg:test": "ast-grep test",
      "prepare": "node -e \"if (process.env.INIT_CWD?.includes('.serverless')) process.exit(0); process.exit(1);\" || husky install || true",
      "nightly:health": "node scripts/check-nightly-e2e-health.mjs",
      "check:skipped-required-checks": "node scripts/check-skipped-required-checks.mjs",
      "check:skipped-required-checks:remote": "node scripts/check-skipped-required-checks.mjs --remote",
      "check:vacuous-required-checks": "node scripts/check-skipped-required-checks.mjs --vacuity",
      "test:node": "node scripts/lisa-test-node.mjs",
      "check:work-item": "node scripts/lisa-work-item.mjs validate-pr",
      "check:conflict-markers": "node scripts/check-conflict-markers.mjs",
      "check:work-item:push": "node scripts/lisa-work-item.mjs validate-push"
    },
    "devDependencies": {
      "eslint-plugin-oxlint": "^1.62.0",
      "oxlint": "^1.62.0",
      "oxlint-tsgolint": "^0.24.0",
      "@stryker-mutator/core": "^9.0.0",
      "@stryker-mutator/vitest-runner": "^9.0.0",
      "fast-check": "^4.9.0"
    },
    "resolutions": {
      "@isaacs/brace-expansion": "^5.0.1",
      "axios": ">=1.18.0",
      "esbuild": ">=0.28.1",
      "handlebars": ">=4.7.9",
      "lodash": ">=4.18.1",
      "multer": ">=2.2.0",
      "undici": "^6.28.0",
      "vite": ">=8.0.16",
      "ws": ">=8.21.0",
      "form-data": ">=4.0.6",
      "systeminformation": ">=5.31.7"
    },
    "overrides": {
      "@isaacs/brace-expansion": "^5.0.1",
      "axios": ">=1.18.0",
      "esbuild": ">=0.28.1",
      "handlebars": ">=4.7.9",
      "lodash": ">=4.18.1",
      "multer": ">=2.2.0",
      "undici": "^6.28.0",
      "vite": "^8.0.16",
      "ws": ">=8.21.0",
      "form-data": ">=4.0.6",
      "systeminformation": ">=5.31.7"
    }
  },
  "defaults": {
    "devDependencies": {
      "@ast-grep/cli": "^0.40.4",
      "@vitest/coverage-v8": "^4.1.0",
      "eslint": "^9.39.0",
      "husky": "^8.0.0",
      "prettier": "^3.3.3",
      "typescript": "^6.0.3",
      "vitest": "^4.1.0"
    },
    "scripts": {
      "build": "tsc",
      "postinstall": "[ -n \"$CI\" ] || LISA_BOOTSTRAP=1 node node_modules/@codyswann/lisa/all/copy-overwrite/scripts/lisa-postinstall.mjs || true",
      "test:integration": "$npm_execpath run test:integration:lisa",
      "lint": "$npm_execpath run lint:lisa",
      "format:check": "$npm_execpath run format:check:lisa",
      "lint:slow": "$npm_execpath run lint:slow:lisa",
      "typecheck": "$npm_execpath run typecheck:lisa",
      "knip:check": "$npm_execpath run knip:check:lisa",
      "sg:scan": "$npm_execpath run sg:scan:lisa"
    },
    "engines": {
      "npm": "please-use-bun",
      "yarn": "please-use-bun",
      "pnpm": "please-use-bun",
      "bun": "1.3.8",
      "node": "22.21.1"
    }
  },
  "merge": {
    "trustedDependencies": [
      "@ast-grep/cli",
      "@codyswann/lisa",
      "@sentry/cli"
    ]
  },
  "remove": {
    "overrides": [
      "brace-expansion"
    ],
    "resolutions": [
      "brace-expansion"
    ],
    "scripts": [
      "knip",
      "knip:lisa"
    ]
  },
  "adopt": {
    "scripts": {
      "test:integration": [
        "vitest run '.integration.' 'integration/'",
        "vitest run tests/integration",
        "vitest run tests/integration --passWithNoTests",
        "NODE_ENV=test jest --testPathPatterns=\"\\.integration[.\\\\-](test|spec)\\.(ts|tsx)$\" --passWithNoTests",
        "NODE_ENV=test jest --testPathPatterns=\"\\.integration\\.test\\.(ts|tsx)$\" --passWithNoTests"
      ],
      "lint": [
        "oxlint && eslint . --quiet",
        "eslint . --quiet"
      ],
      "format:check": [
        "prettier --check ."
      ],
      "lint:slow": [
        "eslint . --config eslint.slow.config.ts --quiet"
      ],
      "typecheck": [
        "tsc --noEmit"
      ],
      "knip:check": [
        "knip"
      ],
      "sg:scan": [
        "ast-grep scan"
      ]
    }
  }
}
