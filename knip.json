{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".lisa/evidence/*/*.mjs",
        "evidence/*/*.{mjs,ts}",
        "scripts/*.{ts,mts,mjs}",
        "scripts/lib/markdown-assertions/record-setup.mjs",
        "scripts/lib/markdown-assertions/record.vitest.config.mjs",
        "scripts/lib/mutation-performance-reporter.mjs",
        "scripts/lib/packaged-apply-driver.mjs",
        "scripts/lib/shell-guard-{terminal-reporter,trace}.mjs",
        "scripts/lib/test-access-map-{setup,tracer}.mjs",
        "scripts/lisa-remote-env/materialized-env-authority.mjs",
        "src/opencode/plugin-templates/*.ts",
        "tests/fixtures/git-history-secrets/{journey,rails-prepush-hook,scanner-path}.mjs",
        "tests/fixtures/mutation-performance/jest/jest.config.ts",
        "tests/fixtures/opencode/host-name-guard-callback.mjs",
        "tests/fixtures/session-manager/support/stubs/*.mjs",
        "tests/helpers/__fixtures__/plugin-registration-cli.mjs",
        "tests/helpers/__fixtures__/{coverage-scratch-concurrent,margin-guard-case}.ts",
        "tests/helpers/history-scanner-global-setup.ts",
        "tests/support/work-item-{fake-aws,stateful-gh,stateful-linear}.mjs"
      ],
      "project": [
        "src/**/*.{ts,css}",
        "scripts/**/*.{ts,mts,mjs}",
        "!scripts/**/*.d.mts",
        "tests/**/*.{ts,mts,mjs}",
        ".lisa/evidence/*/*.mjs",
        "evidence/*/*.{mjs,ts}"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}
